{
   "name": "instagram-clone",
   "version": "0.1.0",
   "private": true,
   "scripts": {
      "dev": "next dev",
      "prebuild": "node scripts/validateLoginImages.mjs",
      "build": "next build",
      "start": "next start",
      "lint": "biome lint --write .",
      "format": "biome format --write . --reporter=summary",
      "check": "biome check --write .",
      "typecheck": "tsc --noEmit",
      "test:unit": "bun test src",
      "test:e2e": "bun --env-file=.env.test run build && bunx playwright test",
      "test:e2e:ui": "bunx playwright test --ui",
      "test:e2e:report": "bunx playwright show-report",
      "db:types": "bunx supabase gen types typescript --project-id pggvzapkivjgsybyzjok > src/types/database.ts",
      "seed:all": "bun run scripts/seed/all.ts",
      "seed:generate": "bun run scripts/seed/generate.ts",
      "seed:process": "bun run scripts/seed/process.ts",
      "seed:seed": "bun run scripts/seed/seed.ts",
      "seed:cleanup": "bun run scripts/seed/helpers/cleanup.ts"
   },
   "dependencies": {
      "@ffmpeg/ffmpeg": "^0.12.15",
      "@ffmpeg/util": "^0.12.2",
      "@hookform/resolvers": "^5.5.7",
      "@lottiefiles/dotlottie-react": "^0.19.12",
      "@mux/mux-node": "^14.1.1",
      "@mux/mux-player-react": "^3.13.2",
      "@radix-ui/react-dialog": "^1.1.23",
      "@radix-ui/react-dropdown-menu": "^2.1.24",
      "@radix-ui/react-hover-card": "^1.1.23",
      "@radix-ui/react-popover": "^1.1.23",
      "@radix-ui/react-separator": "^1.1.15",
      "@radix-ui/react-toast": "^1.2.23",
      "@radix-ui/react-visually-hidden": "^1.2.11",
      "@stylexjs/stylex": "^0.18.3",
      "@supabase/ssr": "^0.10.3",
      "@supabase/supabase-js": "^2.111.0",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-query-devtools": "^5.101.4",
      "@types/bun": "^1.3.14",
      "@vercel/speed-insights": "^2.0.0",
      "emoji-picker-react": "^4.19.1",
      "next": "16.2.4",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "react-dropzone": "^15.0.0",
      "react-hook-form": "^7.83.0",
      "react-icons": "^5.7.0",
      "react-intersection-observer": "^10.1.0",
      "server-only": "^0.0.1",
      "sharp": "^0.35.3",
      "zod": "^4.4.3",
      "zustand": "^5.0.14"
   },
   "devDependencies": {
      "@biomejs/biome": "^2.5.6",
      "@next/bundle-analyzer": "^16.2.12",
      "@playwright/test": "^1.62.1",
      "@stylexjs/babel-plugin": "^0.18.3",
      "@stylexjs/postcss-plugin": "^0.18.3",
      "@types/node": "^20.19.43",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "autoprefixer": "^10.5.4",
      "babel-plugin-react-compiler": "^1.0.0",
      "supabase": "^2.110.0",
      "typescript": "^5.9.3"
   },
   "ignoreScripts": [
      "sharp",
      "unrs-resolver"
   ],
   "trustedDependencies": [
      "sharp",
      "supabase",
      "unrs-resolver"
   ]
}
